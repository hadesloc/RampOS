{
  "meta": {
    "app_url": "http://localhost:3000",
    "start_command": "npm run dev --prefix frontend",
    "wait_for_ready": 90,
    "scope": "truth-first-venue-agnostic-uw-plan"
  },
  "viewports": ["desktop", "mobile"],
  "viewport_presets": {
    "desktop": {
      "width": 1440,
      "height": 900
    },
    "mobile": {
      "device": "iPhone 12"
    }
  },
  "journeys": [
    {
      "id": "J-UW-001",
      "name": "Review readiness and release truth",
      "priority": "critical",
      "preconditions": ["admin authenticated"],
      "steps": [
        {"action": "navigate", "url": "/admin/settings/config-bundles", "description": "Open a governance-adjacent readiness surface"},
        {"action": "verify_visible", "selector": "body", "description": "Page renders"},
        {"action": "screenshot", "name": "readiness-truth", "description": "Capture current readiness-adjacent state"}
      ]
    },
    {
      "id": "J-UW-002",
      "name": "Use truthful admin auth path",
      "priority": "critical",
      "preconditions": ["frontend auth migration complete"],
      "steps": [
        {"action": "navigate", "url": "/admin-login", "description": "Open admin login"},
        {"action": "verify_visible", "selector": "body", "description": "Admin login renders"},
        {"action": "screenshot", "name": "admin-auth-truth", "description": "Capture canonical admin auth surface"}
      ]
    },
    {
      "id": "J-UW-003",
      "name": "Review live treasury evidence",
      "priority": "critical",
      "preconditions": ["admin authenticated", "treasury evidence imported"],
      "steps": [
        {"action": "navigate", "url": "/admin/treasury", "description": "Open treasury workbench"},
        {"action": "verify_visible", "selector": "body", "description": "Treasury page renders"},
        {"action": "screenshot", "name": "treasury-truth", "description": "Capture treasury evidence-backed state"}
      ]
    },
    {
      "id": "J-UW-004",
      "name": "Review reconciliation lineage",
      "priority": "critical",
      "preconditions": ["admin authenticated", "reconciliation evidence imported"],
      "steps": [
        {"action": "navigate", "url": "/admin/reconciliation", "description": "Open reconciliation workbench"},
        {"action": "verify_visible", "selector": "body", "description": "Reconciliation page renders"},
        {"action": "screenshot", "name": "reconciliation-truth", "description": "Capture reconciliation lineage state"}
      ]
    },
    {
      "id": "J-UW-005",
      "name": "Govern partner and corridor pack",
      "priority": "major",
      "preconditions": ["admin authenticated", "partner and corridor records available"],
      "steps": [
        {"action": "navigate", "url": "/admin/settings/extensions", "description": "Open governance shell"},
        {"action": "verify_visible", "selector": "body", "description": "Governance page renders"},
        {"action": "screenshot", "name": "partner-corridor-pack", "description": "Capture partner/corridor governance state"}
      ]
    },
    {
      "id": "J-UW-006",
      "name": "Review venue funding workbench",
      "priority": "major",
      "preconditions": ["admin authenticated", "venue substrate implemented"],
      "steps": [
        {"action": "navigate", "url": "/admin/venue", "description": "Open venue workbench"},
        {"action": "verify_visible", "selector": "body", "description": "Venue workbench renders"},
        {"action": "screenshot", "name": "venue-workbench", "description": "Capture venue trust and transfer review state"}
      ]
    },
    {
      "id": "J-UW-007",
      "name": "Prepare venue funding from portal",
      "priority": "major",
      "preconditions": ["portal authenticated", "wallet exists", "venue funding UI implemented"],
      "steps": [
        {"action": "navigate", "url": "/portal/venues", "description": "Open portal venue funding page"},
        {"action": "verify_visible", "selector": "body", "description": "Venue page renders"},
        {"action": "screenshot", "name": "portal-venue-funding", "description": "Capture venue funding preparation flow"}
      ]
    },
    {
      "id": "J-UW-008",
      "name": "Review Travel Rule and KYB evidence",
      "priority": "major",
      "preconditions": ["admin authenticated"],
      "steps": [
        {"action": "navigate", "url": "/admin/compliance/travel-rule", "description": "Open Travel Rule queue"},
        {"action": "verify_visible", "selector": "body", "description": "Travel Rule page renders"},
        {"action": "navigate", "url": "/admin/compliance/kyb", "description": "Open KYB review"},
        {"action": "verify_visible", "selector": "body", "description": "KYB page renders"},
        {"action": "screenshot", "name": "travel-rule-kyb", "description": "Capture compliance review state"}
      ]
    }
  ]
}
