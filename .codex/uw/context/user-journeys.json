{
  "meta": {
    "app_url": "http://localhost:3000",
    "start_command": "npm run dev --prefix frontend",
    "wait_for_ready": 90,
    "scope": "march-2026-full-scope-plan"
  },
  "viewports": [
    "desktop",
    "mobile"
  ],
  "viewport_presets": {
    "desktop": {
      "width": 1440,
      "height": 900
    },
    "mobile": {
      "device": "iPhone 12"
    }
  },
  "journeys": [
    {
      "id": "J-001",
      "name": "Review Internal Readiness Surface",
      "priority": "critical",
      "preconditions": [
        "release candidate frozen",
        "internal readiness package defined"
      ],
      "steps": [
        {
          "action": "navigate",
          "url": "/admin/settings/config-bundles",
          "description": "Open release-governance-adjacent surface"
        },
        {
          "action": "verify_visible",
          "selector": "body",
          "description": "Governance page renders"
        },
        {
          "action": "screenshot",
          "name": "internal-readiness",
          "description": "Capture internal readiness surface"
        }
      ]
    },
    {
      "id": "J-002",
      "name": "Govern Partner Connector",
      "priority": "critical",
      "preconditions": [
        "admin authenticated",
        "partner registry enabled"
      ],
      "steps": [
