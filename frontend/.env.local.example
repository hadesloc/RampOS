# RampOS Admin Dashboard Environment Configuration

# API Configuration
# DEV: must be '/api' (same-origin). Portal/admin client calls become
#   '/api/v1/...' which next.config rewrites proxy to the backend (:8080).
#   Setting this to the page origin (e.g. http://localhost:3000) makes calls
#   resolve to '/v1/...' which has NO rewrite and 404s.
# PROD: set to the real public API origin (cross-origin, no dev rewrite proxy).
NEXT_PUBLIC_API_URL=/api

# API Key for authentication (optional in development)
# In production, this should be a secure API key
NEXT_PUBLIC_API_KEY=

# Environment
NODE_ENV=development
